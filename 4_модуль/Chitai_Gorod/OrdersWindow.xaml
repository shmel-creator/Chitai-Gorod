<Window x:Class="Chitai_Gorod.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай-город — Заказы"
        Height="700" Width="1000"
        FontFamily="Comic Sans MS"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Список заказов" FontSize="28" FontWeight="Bold" Foreground="#546F94" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Назад к товарам" Click="BtnBack_Click" Background="#ABCFCE" Foreground="#546F94" FontWeight="Bold" Padding="10,5" BorderThickness="0" Margin="0,0,10,0"/>
                <Button x:Name="BtnAddOrder" Content="Добавить заказ" Click="BtnAddOrder_Click" Background="#546F94" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#ABCFCE" CornerRadius="8" Padding="10">
            <ListBox x:Name="LstOrders" Background="Transparent" BorderThickness="0" 
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LstOrders_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#546F94" Margin="0,5" Padding="10" CornerRadius="5" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding НомерЗаказа, StringFormat='Артикул заказа: {0}'}"/>
                                    <TextBlock Text="{Binding Статус, StringFormat='Статус заказа: {0}'}" FontSize="14" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding АдресПункта, StringFormat='Адрес пункта выдачи: {0}'}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding ДатаЗаказа, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}" FontSize="14" Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" BorderBrush="#546F94" BorderThickness="1" Background="#F0F0F0" CornerRadius="5">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                        <TextBlock Text="Дата доставки" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ДатаДоставки, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>