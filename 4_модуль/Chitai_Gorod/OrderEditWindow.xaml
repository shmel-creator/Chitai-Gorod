<Window x:Class="Chitai_Gorod.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа"
        Height="600" Width="500"
        FontFamily="Comic Sans MS"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbTitle" Grid.Row="0" Text="Добавление заказа" FontSize="22" FontWeight="Bold" Foreground="#546F94" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Товар:" FontSize="14" Margin="0,5"/>
            <ComboBox x:Name="CbTovar" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdТовара"/>

            <TextBlock Text="Статус заказа:" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="CbStatus" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdСтатусаЗаказа"/>

            <TextBlock Text="Пункт выдачи (Адрес):" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="CbPunkt" Height="30" DisplayMemberPath="Адрес" SelectedValuePath="IdПункта"/>

            <TextBlock Text="Дата заказа:" FontSize="14" Margin="0,10,0,5"/>
            <DatePicker x:Name="DpDateOrder" Height="30"/>

            <TextBlock Text="Дата доставки:" FontSize="14" Margin="0,10,0,5"/>
            <DatePicker x:Name="DpDateDelivery" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Height="40" Background="#546F94" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnDelete" Content="Удалить" Width="120" Height="40" Background="#FF8080" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDelete_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button Content="Отмена" Width="120" Height="40" Background="#ABCFCE" Foreground="#546F94" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>