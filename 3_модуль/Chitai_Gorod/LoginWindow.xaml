<Window x:Class="Chitai_Gorod.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Читай-город"
        Height="565" Width="550"
        FontFamily="Comic Sans MS"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#ABCFCE" Padding="15">
            <TextBlock Text="Вход в систему" FontSize="26" FontWeight="Bold" Foreground="#546F94" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <Image Source="/icon.png" Width="120" Height="120" Stretch="Uniform" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" FontSize="14" Margin="0,5"/>
            <TextBox x:Name="TbLogin" Height="35" FontSize="14" Padding="5" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль:" FontSize="14" Margin="0,15,0,5"/>
            <PasswordBox x:Name="PbPassword" Height="35" FontSize="14" Padding="5" VerticalContentAlignment="Center"/>

            <Button Content="Войти" Height="45" Margin="0,25,0,10" 
                    Background="#546F94" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0"
                    Click="BtnLogin_Click"/>

            <Button Content="Войти как гость" Height="45" 
                    Background="#ABCFCE" Foreground="#546F94" FontSize="18" FontWeight="Bold" BorderThickness="0"
                    Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>