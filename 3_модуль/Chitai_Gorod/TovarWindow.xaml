<Window x:Class="Chitai_Gorod.TovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара"
        Height="960" Width="600"
        FontFamily="Comic Sans MS"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbTitle" Grid.Row="0" Text="Добавление товара" FontSize="22" FontWeight="Bold" Foreground="#546F94" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Артикул (ID):" FontSize="14" Margin="0,5"/>
                <TextBox x:Name="TbId" Height="30" IsReadOnly="True" Background="#E0E0E0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Наименование:" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="TbName" Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Text="Категория:" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="CbCategory" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdКатегории"/>

                <TextBlock Text="Производитель:" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="CbManufacturer" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdПроизводителя"/>

                <TextBlock Text="Поставщик:" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="CbSupplier" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdПоставщика"/>

                <TextBlock Text="Единица измерения:" FontSize="14" Margin="0,10,0,5"/>
                <ComboBox x:Name="CbUnit" Height="30" DisplayMemberPath="Наименование" SelectedValuePath="IdЕдиницыИзмерения"/>

                <TextBlock Text="Описание:" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="TbDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Цена (руб.):" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="TbPrice" Height="30" VerticalContentAlignment="Center" PreviewTextInput="TbPrice_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Скидка (%):" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="TbDiscount" Height="30" VerticalContentAlignment="Center" PreviewTextInput="TbPrice_PreviewTextInput"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Количество на складе:" FontSize="14" Margin="0,10,0,5"/>
                <TextBox x:Name="TbQuantity" Height="30" VerticalContentAlignment="Center" PreviewTextInput="TbPrice_PreviewTextInput"/>

                <TextBlock Text="Фото:" FontSize="14" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ImgPreview" Grid.Column="0" Width="80" Height="80" Stretch="Uniform" Margin="0,0,10,0"/>
                    <Button x:Name="BtnLoadPhoto" Grid.Column="1" Content="Загрузить фото (300x200)" Height="40" VerticalAlignment="Center" Click="BtnLoadPhoto_Click"/>
                </Grid>
                <TextBox x:Name="TbPhotoPath" IsReadOnly="True" Height="25" Margin="0,5,0,0" Background="#E0E0E0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnDeleteTovar" Content="Удалить" Width="120" Height="40" Background="#FF8080" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDeleteTovar_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="BtnSave" Content="Сохранить" Width="120" Height="40" Background="#546F94" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="120" Height="40" Background="#ABCFCE" Foreground="#546F94" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>