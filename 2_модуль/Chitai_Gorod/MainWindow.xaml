<Window x:Class="Chitai_Gorod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай-город — Список товаров"
        Height="750" Width="1100"
        FontFamily="Comic Sans MS"
        Background="#FFFFFF"
        Icon="/icon.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="/icon.png" Width="80" Height="80" Stretch="Uniform" Margin="0,0,15,0"/>

            <TextBlock Grid.Column="1" Text="Список товаров" FontSize="28" FontWeight="Bold" 
                       VerticalAlignment="Center" Foreground="#546F94"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TbUserFio" Text="Гость" FontSize="16" FontWeight="Bold" 
                           Foreground="#546F94" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button Content="Выйти" Click="BtnLogout_Click" 
                        Background="#546F94" Foreground="White" FontSize="14" 
                        Padding="15,8" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#ABCFCE" CornerRadius="8" Padding="10">
            <ListBox x:Name="ProductsList" Background="Transparent" BorderThickness="0" 
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#546F94" Margin="0,5" Padding="0" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                                            <Setter Property="Background" Value="#23E1EF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#546F94" BorderThickness="0,0,1,0" Padding="10">
                                    <Image Source="{Binding ImageUri}" Stretch="Uniform" Width="140" Height="180"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="15,10" >
                                    <TextBlock TextWrapping="Wrap" FontSize="16" HorizontalAlignment="Center">
                                        <Run Text="{Binding Category}" FontWeight="Bold" Foreground="#546F94"/>
                                        <Run Text=" | " Foreground="#546F94"/>
                                        <Run Text="{Binding Name}" FontWeight="Bold"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description, StringFormat='Описание: {0}'}" 
                                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" 
                                               FontSize="12" Margin="0,5,0,0"/>

                                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производитель: {0}'}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Supplier, StringFormat='Поставщик: {0}'}" FontSize="12" Margin="0,2,0,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Цена: " FontSize="14"/>

                                        <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:N2} руб.'}" 
                                                   TextDecorations="Strikethrough" Foreground="Red" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding FinalPrice, StringFormat='{}{0:N2} руб.'}" 
                                                   FontWeight="Bold" Foreground="Black" FontSize="14" Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Unit, StringFormat='Единица измерения: {0}'}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding TotalQuantity, StringFormat='Количество на складе: {0}'}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" BorderBrush="#546F94" BorderThickness="1,0,0,0" Padding="10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Действующая" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="скидка" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}" 
                                                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#546F94"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>